{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/boxes", "destination": "/frontend/boxes.html" },
    { "source": "/boxes.html", "destination": "/frontend/boxes.html" },
    { "source": "/box-details", "destination": "/frontend/box_details.html" },
    { "source": "/box_details.html", "destination": "/frontend/box_details.html" },
    { "source": "/cart", "destination": "/frontend/cart.html" },
    { "source": "/cart.html", "destination": "/frontend/cart.html" },
    { "source": "/checkout", "destination": "/frontend/checkout.html" },
    { "source": "/checkout.html", "destination": "/frontend/checkout.html" },
    { "source": "/track", "destination": "/frontend/track.html" },
    { "source": "/track.html", "destination": "/frontend/track.html" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/login.html", "destination": "/frontend/login.html" },
    { "source": "/register", "destination": "/frontend/register.html" },
    { "source": "/register.html", "destination": "/frontend/register.html" },
    { "source": "/how-it-works", "destination": "/frontend/how_it_works.html" },
    { "source": "/how_it_works.html", "destination": "/frontend/how_it_works.html" },
    { "source": "/about", "destination": "/frontend/about.html" },
    { "source": "/about.html", "destination": "/frontend/about.html" },
    { "source": "/reviews", "destination": "/frontend/reviews.html" },
    { "source": "/reviews.html", "destination": "/frontend/reviews.html" },
    { "source": "/contact", "destination": "/frontend/contact.html" },
    { "source": "/contact.html", "destination": "/frontend/contact.html" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With" }
      ]
    }
  ]
}
